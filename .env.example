# Copy to .env for local development only. Never commit .env or real credentials.
DATABASE_URL=mysql://gemini:change-me@127.0.0.1:3306/gemini_ops_fleet
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=3000

# Required for the hosted Manus OAuth flow.
OAUTH_SERVER_URL=https://oauth.manus.im
VITE_APP_ID=replace-with-manus-app-id
VITE_OAUTH_PORTAL_URL=https://manus.im/login
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=replace-with-owner-name

# Optional protected integrations. Configure only in the hosting provider’s secret store.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
FLEET_EVENT_INGEST_TOKEN=
PROMETHEUS_METRICS_TOKEN=
